<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         recordTestRunHistory="false"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true": inside the app container the real DB_ and APP_ values are set; tests must never use them. -->
        <env force="true" name="APP_ENV" value="testing"/>
        <env force="true" name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env force="true" name="HASH_DRIVER" value="argon2id"/>
        <env force="true" name="ARGON_MEMORY" value="1024"/>
        <env force="true" name="ARGON_TIME" value="1"/>
        <env force="true" name="BROADCAST_CONNECTION" value="null"/>
        <env force="true" name="CACHE_STORE" value="array"/>
        <env force="true" name="DB_CONNECTION" value="sqlite"/>
        <env force="true" name="DB_DATABASE" value=":memory:"/>
        <env force="true" name="DB_URL" value=""/>
        <env force="true" name="LOG_STACK" value="single"/>
        <env force="true" name="MAIL_MAILER" value="array"/>
        <env force="true" name="QUEUE_CONNECTION" value="sync"/>
        <env force="true" name="SESSION_DRIVER" value="array"/>
        <env force="true" name="PULSE_ENABLED" value="false"/>
        <env force="true" name="TELESCOPE_ENABLED" value="false"/>
        <env force="true" name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
